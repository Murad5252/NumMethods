<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <!--
    PerMonitorV2 DPI awareness — supported natively in .NET Framework 4.7+.
    This enables automatic scaling on high-DPI monitors and per-monitor
    scaling when the window is moved between monitors with different DPI.
  -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
  </System.Windows.Forms.ApplicationConfigurationSection>
</configuration>
